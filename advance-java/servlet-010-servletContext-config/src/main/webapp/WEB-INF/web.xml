<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >
<web-app>
    <display-name>Archetype Created Web Application</display-name>
    <servlet>
        <servlet-name>s1</servlet-name>
        <servlet-class>Servlet1</servlet-class>
        <init-param>
            <param-name>s1-username</param-name>
            <param-value>s1user123</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>s1</servlet-name>
        <url-pattern>/s1</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>s2</servlet-name>
        <servlet-class>Servlet2</servlet-class>
        <init-param>
            <param-name>s2-username</param-name>
            <param-value>s2user123</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>s2</servlet-name>
        <url-pattern>/s2</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>s3</servlet-name>
        <servlet-class>Servlet3</servlet-class>
        <init-param>
            <param-name>s3-username</param-name>
            <param-value>s3user123</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>s3</servlet-name>
        <url-pattern>/s3</url-pattern>
    </servlet-mapping>
    <context-param>
        <param-name>app-wide-username</param-name>
        <param-value>app1234</param-value>
    </context-param>
</web-app>
